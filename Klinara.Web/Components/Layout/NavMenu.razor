@using Klinara.Web.Authorization
@implements IDisposable

@inject NavigationManager NavigationManager
@inject Klinara.Web.Data.ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Klinara.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2 me-2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/patients">
                        <span class="bi bi-people me-2" aria-hidden="true"></span> Pacientes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/appointments">
                        <span class="bi bi-calendar-event me-2" aria-hidden="true"></span> Citas
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/payments">
                        <span class="bi bi-cash-stack me-2" aria-hidden="true"></span> Pagos
                    </NavLink>
                </div>
                @if (IsPlatformAdmin())
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Manage">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Configuración
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="~/" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-box-arrow-right me-2" aria-hidden="true"></span> Cerrar sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Registrarse
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string? _subdomain;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var clinicIdClaim = user.FindFirst("ClinicId")?.Value;
                if (Guid.TryParse(clinicIdClaim, out var clinicId))
                {
                    var clinic = await DbContext.Clinics.FindAsync(clinicId);
                    _subdomain = clinic?.Subdomain;
                }

                if (string.IsNullOrWhiteSpace(_subdomain))
                {
                    var firstClinic = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(DbContext.Clinics);
                    _subdomain = firstClinic?.Subdomain ?? "demo";
                }
            }
        }
        catch
        {
            _subdomain = "demo";
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private bool IsPlatformAdmin()
    {
        var authState = AuthenticationStateProvider.GetAuthenticationStateAsync().Result;
        return authState.User.IsInRole(KlinaraRoles.PlatformAdmin);
    }
}