<div class="k-brand-bar">
    <a class="navbar-brand" href="" aria-label="Klinara, inicio">
        <span class="k-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z" /></svg>
        </span>
        <span class="k-brand-copy"><span>Klinara</span><small>ADMINISTRACIÓN CLÍNICA</small></span>
    </a>
</div>

<div class="k-clinic-switcher" aria-label="Contexto del consultorio">
    <span class="k-clinic-avatar" aria-hidden="true">K</span>
    <span class="k-clinic-copy"><strong>Espacio de trabajo</strong><small>Gestión clínica</small></span>
</div>

<div class="nav-scrollable" onclick="window.klinaraUi?.closeMenu()">
    <nav class="nav flex-column" aria-label="Consultorio">
        <p class="k-nav-heading">Consultorio</p>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2 me-2" aria-hidden="true"></span> Resumen
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/appointments">
                        <span class="bi bi-calendar-event me-2" aria-hidden="true"></span> Agenda
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/patients">
                        <span class="bi bi-people me-2" aria-hidden="true"></span> Pacientes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="staff/payments">
                        <span class="bi bi-cash-stack me-2" aria-hidden="true"></span> Pagos
                    </NavLink>
                </div>
                <p class="k-nav-heading mt-4">Cuenta</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-gear me-2" aria-hidden="true"></span> Mi cuenta
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="~/" />
                        <button type="submit" class="nav-link k-logout">
                            <span class="bi bi-box-arrow-right me-2" aria-hidden="true"></span> Cerrar sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <p class="k-nav-heading mt-4">Acceso</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Iniciar sesión
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Registrarse
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<div class="k-sidebar-footer">
    <span>Gestión clara para tu consultorio</span>
    <AuthorizeView>
        <NotAuthorized>
            <a class="k-privacy-link ms-2 text-muted small" href="/privacy" target="_blank">
                <i class="bi bi-shield-check me-1 small"></i> Aviso de privacidad
            </a>
        </NotAuthorized>
        <Authorized>
            <a class="k-privacy-link ms-2 text-muted small" href="/privacy" target="_blank">
                <i class="bi bi-shield-check me-1 small"></i> Aviso de privacidad
            </a>
        </Authorized>
    </AuthorizeView>
    <div class="k-user-card">
        <span class="k-user-avatar" aria-hidden="true">K</span>
        <span class="k-user-copy"><strong>@context.User.Identity?.Name</strong><small>Sesión activa</small></span>
    </div>
</div>

