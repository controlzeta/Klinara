@inherits LayoutComponentBase
@layout Klinara.Web.Components.Layout.MainLayout

<section class="k-account-settings">
    <header class="k-account-heading">
        <p class="k-account-eyebrow">CUENTA</p>
        <h1>Mi cuenta</h1>
        <p class="text-muted">Administra tu perfil y las opciones de acceso y seguridad.</p>
    </header>

    <div class="row g-4">
        <aside class="col-12 col-lg-3" aria-label="Opciones de cuenta">
            <ManageNavMenu />
        </aside>
        <section class="col-12 col-lg-9" aria-label="Contenido de cuenta">
            <div class="k-account-panel">
                @Body
            </div>
        </section>
    </div>
</section>