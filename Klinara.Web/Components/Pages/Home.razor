@page "/"
@using Microsoft.EntityFrameworkCore
@inject Klinara.Web.Data.ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Panel Principal - Klinara</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container py-4">
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                <div>
                    <h2 class="fw-bold text-primary mb-1">Bienvenido a Klinara</h2>
                    <p class="text-muted mb-0">Sesión iniciada como <strong>@context.User.Identity?.Name</strong></p>
                </div>
                @if (_currentClinic != null)
                {
                    <span class="badge bg-primary fs-6 px-3 py-2">
                        <i class="bi bi-hospital me-1"></i> @_currentClinic.Name
                    </span>
                }
            </div>

            <!-- Métricas Clave del Consultorio -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 bg-primary-subtle text-primary p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase fw-bold small mb-1">Pacientes</h6>
                                <h3 class="fw-bold mb-0">@_patientCount</h3>
                            </div>
                            <i class="bi bi-people fs-1"></i>
                        </div>
                        <a class="stretched-link text-primary mt-2 small text-decoration-none fw-semibold" href="staff/patients">
                            Ver directorio &rarr;
                        </a>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 bg-success-subtle text-success p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase fw-bold small mb-1">Citas Hoy / Próx.</h6>
                                <h3 class="fw-bold mb-0">@_appointmentCount</h3>
                            </div>
                            <i class="bi bi-calendar-event fs-1"></i>
                        </div>
                        <a class="stretched-link text-success mt-2 small text-decoration-none fw-semibold" href="staff/appointments">
                            Ver agenda &rarr;
                        </a>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 bg-info-subtle text-info p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase fw-bold small mb-1">Total Cobrado</h6>
                                <h3 class="fw-bold mb-0">$@_totalCollected.ToString("N2")</h3>
                            </div>
                            <i class="bi bi-cash-coin fs-1"></i>
                        </div>
                        <a class="stretched-link text-info mt-2 small text-decoration-none fw-semibold" href="staff/payments">
                            Ver finanzas &rarr;
                        </a>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 bg-warning-subtle text-warning-emphasis p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-uppercase fw-bold small mb-1">Saldo Pendiente</h6>
                                <h3 class="fw-bold mb-0">$@_totalDue.ToString("N2")</h3>
                            </div>
                            <i class="bi bi-exclamation-circle fs-1"></i>
                        </div>
                        <a class="stretched-link text-warning-emphasis mt-2 small text-decoration-none fw-semibold" href="staff/payments">
                            Ver adeudos &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <!-- Tarjeta Portal del Paciente -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body p-4 text-center">
                            <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                                <i class="bi bi-box-arrow-up-right fs-3"></i>
                            </div>
                            <h5 class="fw-bold">Portal del Paciente</h5>
                            <p class="text-muted small">Accede a la vista pública de reservas de tu clínica para probar el flujo de citas.</p>
                            @if (!string.IsNullOrEmpty(_subdomain))
                            {
                                <a class="btn btn-primary w-100" href="/portal/@_subdomain" target="_blank">
                                    Abrir Portal (/portal/@_subdomain)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">No hay clínica asignada</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Consulta de Citas -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body p-4 text-center">
                            <div class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                                <i class="bi bi-calendar-check fs-3"></i>
                            </div>
                            <h5 class="fw-bold">Verificar Cita por Token</h5>
                            <p class="text-muted small">Accede directamente a la vista de una cita con su token de confirmación o gestión.</p>
                            @if (!string.IsNullOrEmpty(_subdomain))
                            {
                                <a class="btn btn-outline-info w-100" href="/portal/@_subdomain/appointment">
                                    Consultar Citas
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Gestión de Cuenta -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body p-4 text-center">
                            <div class="rounded-circle bg-secondary-subtle text-secondary d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                                <i class="bi bi-person-gear fs-3"></i>
                            </div>
                            <h5 class="fw-bold">Perfil y Seguridad</h5>
                            <p class="text-muted small">Administra tu contraseña, autenticación en dos pasos y datos personales.</p>
                            <a class="btn btn-outline-secondary w-100" href="Account/Manage">
                                Administrar Perfil
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Listado de Clínicas Disponibles (si es SuperAdmin o para pruebas) -->
            @if (_clinics != null && _clinics.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">Clínicas Registradas</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Subdominio</th>
                                        <th>Zona Horaria</th>
                                        <th>Acceso al Portal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var clinic in _clinics)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@clinic.Name</td>
                                            <td><code>@clinic.Subdomain</code></td>
                                            <td><small class="text-muted">@clinic.TimeZoneId</small></td>
                                            <td>
                                                <a class="btn btn-sm btn-outline-primary" href="/portal/@clinic.Subdomain" target="_blank">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Ir al Portal
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <h1 class="display-5 fw-bold text-primary mb-3">Bienvenido a Klinara</h1>
            <p class="lead text-muted mb-4">Sistema integral de gestión de citas, consultorios y portal del paciente.</p>
            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-primary btn-lg px-4" href="Account/Login">Iniciar Sesión</a>
                <a class="btn btn-outline-secondary btn-lg px-4" href="Account/Register">Registrarse</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? _subdomain;
    private Klinara.Web.Data.Clinic? _currentClinic;
    private List<Klinara.Web.Data.Clinic>? _clinics;
    private int _patientCount = 0;
    private int _appointmentCount = 0;
    private decimal _totalCollected = 0m;
    private decimal _totalDue = 0m;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _clinics = await DbContext.Clinics.Where(c => c.IsActive).ToListAsync();

                var clinicIdClaim = user.FindFirst("ClinicId")?.Value;
                if (Guid.TryParse(clinicIdClaim, out var clinicId))
                {
                    _currentClinic = await DbContext.Clinics.FindAsync(clinicId);
                    _subdomain = _currentClinic?.Subdomain;
                }

                if (string.IsNullOrWhiteSpace(_subdomain) && _clinics.Any())
                {
                    _currentClinic = _clinics.First();
                    _subdomain = _currentClinic.Subdomain;
                }

                if (_currentClinic != null)
                {
                    _patientCount = await DbContext.Patients.CountAsync(p => p.ClinicId == _currentClinic.Id);
                    _appointmentCount = await DbContext.Appointments.CountAsync(a => a.ClinicId == _currentClinic.Id && a.StartAt >= DateTime.UtcNow.Date);
                    _totalCollected = await DbContext.Payments.Where(p => p.ClinicId == _currentClinic.Id).SumAsync(p => p.Amount);
                    var allTotalDue = await DbContext.Patients.Where(p => p.ClinicId == _currentClinic.Id).SumAsync(p => p.TotalDue);
                    _totalDue = Math.Max(0, allTotalDue - _totalCollected);
                }
            }
        }
        catch
        {
            // Manejo silencioso en carga inicial si aún no está inicializada la BD
        }
    }
}
