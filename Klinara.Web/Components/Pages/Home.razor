@page "/"
@using Microsoft.EntityFrameworkCore
@using Klinara.Web.Data
@using System.Globalization
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Panel Principal - Klinara</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="k-app-content">
            <!-- Header Section -->
            <div class="k-dashboard-header mb-4">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="k-page-title mb-1">Panel Principal</h1>
                        <p class="k-muted-text mb-0">
                            Sesión iniciada como <strong>@context.User.Identity?.Name</strong>
                        </p>
                    </div>
                    @if (_currentClinic != null)
                    {
                        <span class="k-clinic-badge">
                            <svg class="k-clinic-badge-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-13h10v2H7V7zm0 4h10v2H7v-2zm0 4h10v2H7v-2z" />
                            </svg>
                            @_currentClinic.Name
                        </span>
                    }
                </div>

                <!-- Demo Data Badge -->
                <div class="k-demo-badge mb-4" role="status" aria-live="polite">
                    <svg class="k-demo-badge-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" />
                    </svg>
                    <span>Modo demostración - Datos de ejemplo</span>
                </div>
            </div>

            <!-- Key Metrics Row (4 Indicadores) -->
            <div class="k-metrics-grid mb-5">
                <!-- Pacientes -->
                <article class="k-metric-card k-metric-patients">
                    <div class="k-metric-content">
                        <div class="k-metric-header">
                            <h6 class="k-metric-label">Pacientes</h6>
                            <div class="k-metric-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                </svg>
                            </div>
                        </div>
                        <div class="k-metric-value" aria-label="@_patientCount pacientes registrados">
                            @_patientCount
                        </div>
                    </div>
                    <a class="k-metric-link" href="staff/patients">
                        Ver directorio
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                </article>

                <!-- Citas Hoy/Próximas -->
                <article class="k-metric-card k-metric-appointments">
                    <div class="k-metric-content">
                        <div class="k-metric-header">
                            <h6 class="k-metric-label">Citas Hoy / Próx.</h6>
                            <div class="k-metric-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </div>
                        </div>
                        <div class="k-metric-value" aria-label="@_appointmentCount citas programadas">
                            @_appointmentCount
                        </div>
                    </div>
                    <a class="k-metric-link" href="staff/appointments">
                        Ver agenda
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                </article>

                <!-- Total Cobrado -->
                <article class="k-metric-card k-metric-collected">
                    <div class="k-metric-content">
                        <div class="k-metric-header">
                            <h6 class="k-metric-label">Total Cobrado</h6>
                            <div class="k-metric-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                            </div>
                        </div>
                        <div class="k-metric-value" aria-label="Total cobrado @_totalCollected.ToString("C", new System.Globalization.CultureInfo("es-MX"))">
                            @_totalCollected.ToString("C", _mxCulture)
                        </div>
                    </div>
                    <a class="k-metric-link" href="staff/payments">
                        Ver finanzas
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                </article>

                <!-- Saldo Pendiente -->
                <article class="k-metric-card k-metric-due">
                    <div class="k-metric-content">
                        <div class="k-metric-header">
                            <h6 class="k-metric-label">Saldo Pendiente</h6>
                            <div class="k-metric-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                            </div>
                        </div>
                        <div class="k-metric-value" aria-label="Saldo pendiente @_totalDue.ToString("C", new System.Globalization.CultureInfo("es-MX"))">
                            @_totalDue.ToString("C", _mxCulture)
                        </div>
                    </div>
                    <a class="k-metric-link" href="staff/payments">
                        Ver adeudos
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </a>
                </article>
            </div>

            <!-- Main Content Grid: Agenda + Próxima Cita + Acciones Rápidas + Actividad/Pagos -->
            <div class="k-dashboard-grid mb-5">
                <!-- Agenda del Día (Left Column) -->
                <section class="k-dashboard-section k-agenda-section" aria-labelledby="agenda-title">
                    <header class="k-section-header">
                        <h2 id="agenda-title" class="k-section-title">Agenda de Hoy</h2>
                        <a class="k-section-link" href="staff/appointments">
                            Ver todo
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </header>
                    <div class="k-agenda-list" role="list" aria-label="Citas programadas para hoy">
                        @if (_todayAppointments.Any())
                        {
                            @foreach (var appt in _todayAppointments)
                            {
                                <article class="k-agenda-item @appt.StatusClass" role="listitem">
                                    <time class="k-agenda-time" datetime="@appt.StartAt.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        @appt.StartAt.ToString("HH:mm", _mxCulture)
                                    </time>
                                    <div class="k-agenda-info">
                                        <p class="k-agenda-patient">@appt.PatientName</p>
                                        <p class="k-agenda-doctor">Dr. @appt.DoctorName</p>
                                    </div>
                                    <span class="k-agenda-status @appt.StatusBadgeClass">
                                        @appt.StatusText
                                    </span>
                                </article>
                            }
                        }
                        else
                        {
                            <div class="k-empty-state" role="status">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                                <p>No hay citas programadas para hoy</p>
                                <a class="k-empty-action" href="staff/appointments">
                                    Programar primera cita
                                </a>
                            </div>
                        }
                    </div>
                </section>

                <!-- Próxima Cita + Acciones Rápidas (Right Column) -->
                <div class="k-dashboard-side">
                    <!-- Próxima Cita -->
                    <section class="k-dashboard-card k-next-appointment" aria-labelledby="next-title">
                        <header class="k-card-header">
                            <h3 id="next-title" class="k-card-title">Próxima Cita</h3>
                        </header>
                        @if (_nextAppointment != null)
                        {
                            <div class="k-next-appt-content">
                                <div class="k-next-appt-time">
                                    @_nextAppointment.StartAt.ToString("HH:mm", _mxCulture)
                                </div>
                                <div class="k-next-appt-details">
                                    <p class="k-next-appt-patient">@_nextAppointment.PatientName</p>
                                    <p class="k-next-appt-doctor">Dr. @_nextAppointment.DoctorName</p>
                                </div>
                                <span class="k-next-appt-status @_nextAppointment.StatusBadgeClass">
                                    @_nextAppointment.StatusText
                                </span>
                                <a class="k-next-appt-action" href="staff/appointments">
                                    Gestionar
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="k-next-appt-empty">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                                <p>Sin próximas citas</p>
                            </div>
                        }
                    </section>

                    <!-- Acciones Rápidas -->
                    <section class="k-dashboard-card k-quick-actions" aria-labelledby="actions-title">
                        <header class="k-card-header">
                            <h3 id="actions-title" class="k-card-title">Acciones Rápidas</h3>
                        </header>
                        <div class="k-actions-grid" role="list">
                            <a class="k-action-btn" href="staff/patients/create" role="listitem" aria-label="Nuevo paciente">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                </svg>
                                <span>Nuevo Paciente</span>
                            </a>
                            <a class="k-action-btn" href="staff/appointments/create" role="listitem" aria-label="Nueva cita">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                                <span>Nueva Cita</span>
                            </a>
                            <a class="k-action-btn" href="staff/payments/create" role="listitem" aria-label="Registrar pago">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                    <line x1="12" y1="1" x2="12" y2="23" />
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                </svg>
                                <span>Registrar Pago</span>
                            </a>
                            <a class="k-action-btn" href="/portal/@_subdomain" target="_blank" role="listitem" aria-label="Abrir portal del paciente">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                    <polyline points="15 3 21 3 21 9" />
                                    <line x1="10" y1="14" x2="21" y2="3" />
                                </svg>
                                <span>Portal Paciente</span>
                            </a>
                        </div>
                    </section>
                </div>
            </div>

            <!-- Actividad Reciente + Pagos Recientes (Bottom Row) -->
            <div class="k-dashboard-bottom-grid mb-5">
                <!-- Actividad Semanal -->
                <section class="k-dashboard-card k-activity-section" aria-labelledby="activity-title">
                    <header class="k-card-header">
                        <h2 id="activity-title" class="k-section-title">Actividad Reciente</h2>
                    </header>
                    <div class="k-activity-list" role="list" aria-label="Actividad reciente del consultorio">
                        @if (_recentActivity.Any())
                        {
                            @foreach (var item in _recentActivity)
                            {
                                <article class="k-activity-item" role="listitem">
                                    <div class="k-activity-icon @item.IconClass" aria-hidden="true">
                                        @item.Icon
                                    </div>
                                    <div class="k-activity-content">
                                        <p class="k-activity-text">@item.Description</p>
                                        <time class="k-activity-time" datetime="@item.Timestamp.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            @item.RelativeTime
                                        </time>
                                    </div>
                                </article>
                            }
                        }
                        else
                        {
                            <div class="k-empty-state" role="status">
                                <p>Sin actividad reciente</p>
                            </div>
                        }
                    </div>
                </section>

                <!-- Pagos Recientes -->
                <section class="k-dashboard-card k-payments-section" aria-labelledby="payments-title">
                    <header class="k-card-header">
                        <h2 id="payments-title" class="k-section-title">Pagos Recientes</h2>
                        <a class="k-section-link" href="staff/payments">
                            Ver todo
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </a>
                    </header>
                    <div class="k-payments-list" role="list" aria-label="Pagos registrados recientemente">
                        @if (_recentPayments.Any())
                        {
                            @foreach (var payment in _recentPayments)
                            {
                                <article class="k-payment-item" role="listitem">
                                    <div class="k-payment-info">
                                        <p class="k-payment-patient">@payment.PatientName</p>
                                        <p class="k-payment-concept">@payment.Concept</p>
                                    </div>
                                    <div class="k-payment-amount">
                                        @payment.Amount.ToString("C", _mxCulture)
                                    </div>
                                    <time class="k-payment-date" datetime="@payment.PaidAt.ToString("yyyy-MM-dd")">
                                        @payment.PaidAt.ToString("dd MMM", _mxCulture)
                                    </time>
                                </article>
                            }
                        }
                        else
                        {
                            <div class="k-empty-state" role="status">
                                <p>No hay pagos registrados</p>
                                <a class="k-empty-action" href="staff/payments/create">
                                    Registrar primer pago
                                </a>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="k-landing">
            <div class="k-landing-content">
                <svg class="k-landing-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-13h10v2H7V7zm0 4h10v2H7v-2zm0 4h10v2H7v-2z" />
                </svg>
                <h1 class="k-landing-title">Bienvenido a Klinara</h1>
                <p class="k-landing-subtitle">Sistema integral de gestión de citas, consultorios y portal del paciente.</p>
                <div class="k-landing-actions">
                    <a class="btn btn-primary btn-lg" href="Account/Login">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <polyline points="10 17 15 12 10 7" />
                            <line x1="15" y1="12" x2="3" y2="12" />
                        </svg>
                        Iniciar Sesión
                    </a>
                    <a class="btn btn-outline-primary btn-lg" href="Account/Register">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <line x1="19" y1="8" x2="19" y2="14" />
                            <line x1="22" y1="11" x2="16" y2="11" />
                        </svg>
                        Registrarse
                    </a>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly CultureInfo _mxCulture = new("es-MX");

    private string? _subdomain;
    private Clinic? _currentClinic;
    private List<Clinic>? _clinics;
    private int _patientCount = 0;
    private int _appointmentCount = 0;
    private decimal _totalCollected = 0m;
    private decimal _totalDue = 0m;

    // Dashboard Data
    private List<DashboardAppointment> _todayAppointments = new();
    private DashboardAppointment? _nextAppointment;
    private List<ActivityItem> _recentActivity = new();
    private List<PaymentItem> _recentPayments = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // Load clinics
                _clinics = await DbContext.Clinics.Where(c => c.IsActive).ToListAsync();

                var clinicIdClaim = user.FindFirst("ClinicId")?.Value;
                if (Guid.TryParse(clinicIdClaim, out var clinicId))
                {
                    _currentClinic = await DbContext.Clinics.FindAsync(clinicId);
                    _subdomain = _currentClinic?.Subdomain;
                }

                if (string.IsNullOrWhiteSpace(_subdomain) && _clinics?.Any() == true)
                {
                    _currentClinic = _clinics.First();
                    _subdomain = _currentClinic.Subdomain;
                }

                if (_currentClinic != null)
                {
                    // Load metrics
                    await LoadMetricsAsync();

                    // Load dashboard data
                    await LoadDashboardDataAsync();
                }
            }
        }
        catch
        {
            // Silent handling if DB not initialized
        }
    }

    private async Task LoadMetricsAsync()
    {
        if (_currentClinic == null) return;

        _patientCount = await DbContext.Patients.CountAsync(p => p.ClinicId == _currentClinic.Id);
        _appointmentCount = await DbContext.Appointments
            .CountAsync(a => a.ClinicId == _currentClinic.Id && a.StartAt >= DateTime.UtcNow.Date);

        _totalCollected = await DbContext.Payments
            .Where(p => p.ClinicId == _currentClinic.Id)
            .SumAsync(p => (decimal?)p.Amount) ?? 0m;

        var allTotalDue = await DbContext.Patients
            .Where(p => p.ClinicId == _currentClinic.Id)
            .SumAsync(p => (decimal?)p.TotalDue) ?? 0m;

        _totalDue = Math.Max(0, allTotalDue - _totalCollected);
    }

    private async Task LoadDashboardDataAsync()
    {
        if (_currentClinic == null) return;

        var now = DateTime.UtcNow;
        var todayStart = now.Date;
        var todayEnd = todayStart.AddDays(1);
        var weekAgo = now.AddDays(-7);

        // Today's appointments
        _todayAppointments = await DbContext.Appointments
            .Where(a => a.ClinicId == _currentClinic.Id
                && a.StartAt >= todayStart
                && a.StartAt < todayEnd
                && a.Status != AppointmentStatus.CancelledByPatient
                && a.Status != AppointmentStatus.CancelledByStaff)
            .OrderBy(a => a.StartAt)
            .Select(a => new DashboardAppointment
            {
                Id = a.Id,
                StartAt = a.StartAt,
                PatientName = a.Patient.FullName,
                DoctorName = a.Doctor.FullName ?? "Sin asignar",
                Status = a.Status,
                StatusText = GetStatusText(a.Status),
                StatusClass = GetStatusClass(a.Status),
                StatusBadgeClass = GetStatusBadgeClass(a.Status)
            })
            .ToListAsync();

        // Next upcoming appointment
        _nextAppointment = await DbContext.Appointments
            .Where(a => a.ClinicId == _currentClinic.Id
                && a.StartAt >= now
                && a.Status != AppointmentStatus.CancelledByPatient
                && a.Status != AppointmentStatus.CancelledByStaff)
            .OrderBy(a => a.StartAt)
            .Select(a => new DashboardAppointment
            {
                Id = a.Id,
                StartAt = a.StartAt,
                PatientName = a.Patient.FullName,
                DoctorName = a.Doctor.FullName ?? "Sin asignar",
                Status = a.Status,
                StatusText = GetStatusText(a.Status),
                StatusClass = GetStatusClass(a.Status),
                StatusBadgeClass = GetStatusBadgeClass(a.Status)
            })
            .FirstOrDefaultAsync();

        // Recent activity (last 7 days)
        _recentActivity = await BuildRecentActivityAsync(weekAgo);

        // Recent payments (last 10)
        _recentPayments = await DbContext.Payments
            .Where(p => p.ClinicId == _currentClinic.Id)
            .OrderByDescending(p => p.PaidAt)
            .Take(10)
            .Select(p => new PaymentItem
            {
                Id = p.Id,
                PaidAt = p.PaidAt,
                Amount = p.Amount,
                Concept = p.Concept ?? "Pago",
                PatientName = p.Patient.FullName
            })
            .ToListAsync();
    }

    private async Task<List<ActivityItem>> BuildRecentActivityAsync(DateTime since)
    {
        if (_currentClinic == null) return new();

        var activities = new List<ActivityItem>();

        // Recent appointments
        var recentAppts = await DbContext.Appointments
            .Where(a => a.ClinicId == _currentClinic.Id
                && a.CreatedAt >= since
                && a.Status != AppointmentStatus.CancelledByPatient
                && a.Status != AppointmentStatus.CancelledByStaff)
            .OrderByDescending(a => a.CreatedAt)
            .Take(5)
            .Select(a => new ActivityItem
            {
                Timestamp = a.CreatedAt,
                Description = $"Cita {GetStatusText(a.Status).ToLower()} para {a.Patient.FullName} con Dr. {a.Doctor.FullName ?? "sin asignar"}",
                Icon = GetActivityIcon(a.Status),
                IconClass = GetActivityIconClass(a.Status)
            })
            .ToListAsync();

        activities.AddRange(recentAppts);

        // Recent payments
        var recentPays = await DbContext.Payments
            .Where(p => p.ClinicId == _currentClinic.Id && p.PaidAt >= since)
            .OrderByDescending(p => p.PaidAt)
            .Take(5)
            .Select(p => new ActivityItem
            {
                Timestamp = p.PaidAt,
                Description = $"Pago de {p.Amount.ToString("C", _mxCulture)} de {p.Patient.FullName} ({p.Concept ?? "Pago"})",
                Icon = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>",
                IconClass = "k-activity-icon-success"
            })
            .ToListAsync();

        activities.AddRange(recentPays);

        return activities
            .OrderByDescending(a => a.Timestamp)
            .Take(8)
            .ToList();
    }

