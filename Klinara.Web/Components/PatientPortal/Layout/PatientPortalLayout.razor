@inherits LayoutComponentBase
@inject PatientPortalSessionState SessionState

<div class="page klinara-shell">
    <div class="sidebar klinara-sidebar">
        <div class="top-row px-3 py-3">
            <h3 class="k-brand-copy mb-3 d-flex align-items-center">
                <span class="k-brand-mark me-2 text-primary">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-12S17.52 2 12 2zM12 4.2c1.37 0 2.7.43 3.87 1.24L15 5.82V10H9V5.82L10.13 4.2C11.5 3.57 12.87 3 14.2 3c3.07 0 5.5 2.47 5.5 5.5S6.07 14 2 14S-3.5 10.5-3.5 7c0-2.47 2.43-4.5 5.5-4.86z"/>
                    </svg>
                </span>
                <span class="fw-bold">@(string.IsNullOrEmpty(ClinicName) ? (SessionState.ClinicName ?? "Klinara") : ClinicName)</span>
            </h3>

            <nav class="nav flex-column gap-1">
                <a class="nav-link text-dark py-2 px-3 rounded hover-bg" href="/portal/@EffectiveSubdomain">
                    <i class="bi bi-house-door me-2"></i> Inicio
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-bg" href="/portal/@EffectiveSubdomain/verify">
                    <i class="bi bi-calendar-plus me-2"></i> Reservar cita
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded hover-bg" href="/portal/@EffectiveSubdomain/appointment">
                    <i class="bi bi-calendar-check me-2"></i> Mis citas
                </a>
            </nav>

            @if (!string.IsNullOrEmpty(SessionState.PatientEmail))
            {
                <div class="mt-4 p-3 bg-light rounded border">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                             style="width: 36px; height: 36px; font-weight: bold;">
                            @((SessionState.PatientName ?? SessionState.PatientEmail)[0].ToString().ToUpper())
                        </div>
                        <div class="text-truncate">
                            <div class="fw-bold text-truncate small">@(SessionState.PatientName ?? "Paciente")</div>
                            <small class="text-muted text-truncate d-block">@SessionState.PatientEmail</small>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="k-sidebar-footer mt-auto p-3 text-muted border-top small">
            <span>Klinara SaaS — Portal del Paciente</span>
        </div>
    </div>

    <main class="klinara-main flex-grow-1 p-3 p-md-4">
        <div class="container-fluid max-w-4xl">
            @Body
        </div>
    </main>
</div>

@code {
    [Parameter] public string ContextClinicSubdomain { get; set; } = "";
    [Parameter] public string? ClinicName { get; set; }

    private string EffectiveSubdomain => !string.IsNullOrEmpty(ContextClinicSubdomain)
        ? ContextClinicSubdomain
        : (!string.IsNullOrEmpty(SessionState.ClinicSubdomain) ? SessionState.ClinicSubdomain : "demo");

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ContextClinicSubdomain))
        {
            SessionState.ClinicSubdomain = ContextClinicSubdomain;
        }
    }
}
