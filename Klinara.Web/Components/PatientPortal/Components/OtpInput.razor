@using Klinara.Web
@using Klinara.Web.Services

<div class="otp-input-card p-3 border rounded shadow-sm">
    <h5 class="fw-bold mb-3 text-center">Código de verificación</h5>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-2 small">@_errorMessage</div>
    }

    <div class="d-flex justify-content-center gap-2 mb-3">
        @for (int i = 0; i < 6; i++)
        {
            var idx = i;
            <input type="text"
                   maxlength="1"
                   class="form-control text-center fs-4 fw-bold p-1"
                   style="width: 45px; height: 50px;"
                   inputmode="numeric"
                   value="@_otpBoxes[idx]"
                   @oninput="(e) => HandleInput(idx, e)" />
        }
    </div>

    <div class="otp-footer">
        <button class="btn btn-primary w-100" @onclick="VerifyCode" disabled="@(!CanVerify || _sending)">
            @if (_sending)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Verificando...</span>
            }
            else
            {
                <span>Verificar código</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public string? ContextClinicSubdomain { get; set; }
    [Parameter] public string? Email { get; set; }
    [Parameter] public EventCallback<string> OnVerificationComplete { get; set; }

    private readonly string[] _otpBoxes = new string[6] { "", "", "", "", "", "" };
    private string? _errorMessage;
    private bool _sending = false;

    private bool CanVerify => _otpBoxes.All(b => !string.IsNullOrEmpty(b));

    [Inject] private IPatientPortalService PortalService { get; set; } = null!;

    private void HandleInput(int index, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        _otpBoxes[index] = val.Length > 0 ? val[0].ToString() : "";
    }

    private async Task VerifyCode()
    {
        var code = string.Join("", _otpBoxes);
        if (code.Length != 6) return;

        _sending = true;
        _errorMessage = null;

        try
        {
            var email = Email ?? "";
            var subdomain = ContextClinicSubdomain ?? "";
            var result = await PortalService.ValidateOtpAndCreatePortalTokenAsync(email, code, subdomain);
            if (result.Success && !string.IsNullOrEmpty(result.PortalToken))
            {
                await OnVerificationComplete.InvokeAsync(result.PortalToken);
            }
            else
            {
                _errorMessage = result.Error ?? "Código de verificación inválido";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al validar el código: {ex.Message}";
        }
        finally
        {
            _sending = false;
        }
    }
}
