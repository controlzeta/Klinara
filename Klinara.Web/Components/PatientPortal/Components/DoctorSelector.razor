@using Klinara.Web.Services

<div class="doctor-selector mb-4">
    <label class="form-label fw-bold">Selecciona a tu profesional:</label>
    @if (Doctors == null || Doctors.Count == 0)
    {
        <div class="alert alert-warning">
            <span>No hay profesionales disponibles para esta clínica en este momento.</span>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var doc in Doctors)
            {
                var isSelected = SelectedDoctor?.DoctorId == doc.DoctorId;
                <div class="col-12 col-md-6">
                    <div class="card h-100 border @(isSelected ? "border-primary shadow-sm bg-light" : "")"
                         style="cursor: pointer;"
                         @onclick="() => OnSelectDoctor(doc)">
                        <div class="card-body d-flex align-items-center">
                            <div class="me-3 rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                 style="width: 48px; height: 48px; font-weight: bold; font-size: 1.2rem;">
                                @(string.IsNullOrEmpty(doc.DoctorName) ? "D" : doc.DoctorName[0].ToString().ToUpper())
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="card-title mb-1">@doc.DoctorName</h6>
                                <p class="card-text text-muted small mb-0">@(doc.Specialty ?? "Especialista")</p>
                                <span class="badge bg-secondary">@doc.WeeklySchedule.Count días con agenda</span>
                            </div>
                            @if (isSelected)
                            {
                                <span class="badge bg-primary text-white">Seleccionado</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<DoctorAvailabilityDto> Doctors { get; set; } = new();
    [Parameter] public DoctorAvailabilityDto? SelectedDoctor { get; set; }
    [Parameter] public EventCallback<DoctorAvailabilityDto> SelectedDoctorChanged { get; set; }

    private async Task OnSelectDoctor(DoctorAvailabilityDto doc)
    {
        SelectedDoctor = doc;
        await SelectedDoctorChanged.InvokeAsync(doc);
    }
}
