@page "/portal/{ContextClinicSubdomain}/verify"
@layout PatientPortalLayout
@rendermode InteractiveServer
@inject IPatientPortalService PortalService
@inject PatientPortalSessionState SessionState
@inject NavigationManager NavigationManager

<div class="verify-section card shadow-sm p-4 my-3 max-w-md mx-auto" style="max-width: 500px;">
    <h3 class="fw-bold mb-3 text-center">Verificación por correo</h3>
    <p class="text-muted text-center mb-4 small">
        Ingresa tu correo para recibir un código de seguridad de 6 dígitos.
    </p>

    @if (_isSending)
    {
        <div class="d-flex align-items-center justify-content-center py-3">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <span>Enviando código...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span>@_errorMessage</span>
        </div>
    }
    else if (_otpSent)
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-envelope-check me-2"></i>
            <span>Hemos enviado un código de 6 dígitos a <strong>@_email</strong>.</span>
        </div>
    }

    @if (!_otpSent)
    {
        <div class="mb-3">
            <label class="form-label fw-bold">Correo electrónico</label>
            <input type="email" class="form-control" @bind="_email" placeholder="nombre@correo.com" maxlength="254" />
        </div>
        <button class="btn btn-primary w-100" @onclick="SendOtp" disabled="@_isSending">
            Enviar código de acceso
        </button>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label fw-bold">Código de 6 dígitos</label>
            <input type="text" class="form-control text-center fs-4 letter-spacing" @bind="_otpCode" maxlength="6" placeholder="000000" />
            <div class="form-text">El código tiene una validez de 1 hora.</div>
        </div>
        <button class="btn btn-primary w-100 mb-2" @onclick="ValidateOtp" disabled="@_isSending">
            Validar y continuar
        </button>
        <button class="btn btn-link text-decoration-none w-100" @onclick="ResendOtp" disabled="@_isSending">
            Reenviar código
        </button>
    }

    <div class="text-center mt-3 border-top pt-3">
        <a href="/portal/@ContextClinicSubdomain" class="text-muted text-decoration-none small">
            &larr; Volver al inicio
        </a>
    </div>
</div>

@code {
    [Parameter] public string ContextClinicSubdomain { get; set; } = "";

    private string _email = "";
    private string _otpCode = "";
    private bool _otpSent = false;
    private string? _errorMessage;
    private bool _isSending = false;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(SessionState.PatientEmail))
        {
            _email = SessionState.PatientEmail;
        }
    }

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _errorMessage = "Por favor introduce un correo electrónico válido.";
            return;
        }

        _errorMessage = null;
        _isSending = true;

        try
        {
            var result = await PortalService.SendVerificationEmailAsync(_email.Trim(), ContextClinicSubdomain);
            if (result.Success)
            {
                _otpSent = true;
                SessionState.PatientEmail = _email.Trim();
                SessionState.ClinicSubdomain = ContextClinicSubdomain;
            }
            else
            {
                _errorMessage = result.Error ?? "Error al enviar el código de verificación.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task ValidateOtp()
    {
        if (string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Length != 6)
        {
            _errorMessage = "El código debe constar de 6 dígitos.";
            return;
        }

        _errorMessage = null;
        _isSending = true;

        try
        {
            var result = await PortalService.ValidateOtpAndCreatePortalTokenAsync(_email.Trim(), _otpCode.Trim(), ContextClinicSubdomain);
            if (result.Success && !string.IsNullOrEmpty(result.PortalToken))
            {
                SessionState.PortalToken = result.PortalToken;
                SessionState.PatientEmail = _email.Trim();
                SessionState.ClinicSubdomain = ContextClinicSubdomain;

                NavigationManager.NavigateTo($"/portal/{ContextClinicSubdomain}/booking");
            }
            else
            {
                _errorMessage = result.Error ?? "Código de verificación inválido o expirado.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task ResendOtp()
    {
        _otpSent = false;
        _errorMessage = null;
        _otpCode = "";
        await SendOtp();
    }
}
